---
import { formatDate, slugFromId } from '../lib/posts';
import { href, type Post } from '../lib/content';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="border-t border-line py-10 text-muted">첫 글을 준비하고 있습니다.</p>
  ) : (
    <ol class="border-t border-line">
      {posts.map((post) => (
        <li class="border-b border-line">
          <a
            href={href(`posts/${slugFromId(post.id)}/`)}
            class="group grid gap-1 py-6 sm:grid-cols-[7rem_1fr] sm:gap-6"
          >
            <time datetime={post.data.date.toISOString()} class="pt-0.5 text-sm tabular-nums text-muted">
              {formatDate(post.data.date)}
            </time>
            <div>
              <h3 class="text-lg font-semibold text-ink transition-colors group-hover:text-teal-deep">
                {post.data.title}
                {post.data.draft && <span class="ml-2 text-xs font-medium text-muted">draft</span>}
              </h3>
              <p class="mt-1 text-[0.9375rem] text-ink-2">{post.data.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  )
}
