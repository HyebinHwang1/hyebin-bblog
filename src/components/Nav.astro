---
import { href } from '../lib/content';

interface Props {
  active?: 'about' | 'blog';
}

const { active } = Astro.props;
const items = [
  { id: 'about', label: 'About' },
  { id: 'blog', label: 'Blog' },
] as const;
---

<header class="sticky top-0 z-20 border-b border-line bg-bg/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5" aria-label="주요 메뉴">
    <a href={href()} class="text-[1.0625rem] font-semibold tracking-[-0.02em] text-ink">
      hyebin<span class="text-teal">.</span>dev
    </a>
    <ul class="flex gap-6 text-[0.9375rem] font-medium">
      {
        items.map((item) => (
          <li>
            <a
              href={href(`#${item.id}`)}
              data-nav={item.id}
              aria-current={active === item.id ? 'location' : undefined}
              class="nav-link"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.25rem 0;
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--teal);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  .nav-link[aria-current]::after {
    transform: scaleX(1);
  }

  .nav-link[aria-current] {
    color: var(--ink);
  }
</style>
