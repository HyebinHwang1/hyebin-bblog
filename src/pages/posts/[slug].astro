---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, href, type Post } from '../../lib/content';
import { formatDate, getAdjacentPosts, slugFromId } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: slugFromId(post.id) },
    props: { post, ...getAdjacentPosts(posts, post.id) },
  }));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.summary} active="blog">
  <article class="mx-auto max-w-5xl px-5 pt-12 pb-16 sm:pt-16">
    <header class="max-w-[38em]">
      <time datetime={post.data.date.toISOString()} class="text-sm tabular-nums text-muted">
        {formatDate(post.data.date)}
      </time>
      <h1 class="mt-2 text-[1.75rem] font-semibold text-ink sm:text-[2.125rem]">{post.data.title}</h1>
      <p class="mt-3 text-ink-2">{post.data.summary}</p>
    </header>
    <div class="prose mt-10">
      <Content />
    </div>
  </article>

  <nav class="mx-auto max-w-5xl px-5 pb-20" aria-label="이전·다음 글">
    <div class="grid max-w-[38em] gap-3 border-t border-line pt-8 sm:grid-cols-2">
      {
        prev ? (
          <a href={href(`posts/${slugFromId(prev.id)}/`)} class="adjacent">
            <span class="text-xs text-muted">이전 글</span>
            <span class="font-medium text-ink">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={href(`posts/${slugFromId(next.id)}/`)} class="adjacent sm:text-right">
            <span class="text-xs text-muted">다음 글</span>
            <span class="font-medium text-ink">{next.data.title}</span>
          </a>
        )
      }
    </div>
  </nav>
</Base>

<style>
  .adjacent {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    transition: background-color 0.2s;
  }

  .adjacent:hover {
    background: var(--mint);
  }
</style>
