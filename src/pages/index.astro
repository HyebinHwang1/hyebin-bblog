---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Character from '../components/Character';
import { getPosts, href } from '../lib/content';
import { profile } from '../data/profile';

const posts = await getPosts();
---

<Base>
  <section id="about" class="mx-auto max-w-5xl px-5 pt-10 pb-20 sm:pt-16">
    <h2 class="sr-only">About Me</h2>
    <div class="grid items-center gap-10 md:grid-cols-[minmax(0,26rem)_1fr] md:gap-14">
      <div
        class="stage relative aspect-[4/5] w-full overflow-hidden rounded-stage bg-bg-soft"
        data-stage
        aria-label="3D 캐릭터. 클릭하면 소개 카드가 열립니다."
      >
        <img
          class="fallback absolute inset-0 h-full w-full object-contain"
          src={href('character-fallback.png')}
          alt="검정 반팔 티셔츠와 검정 바지를 입고 웃으며 브이를 하고 서 있는 3D 캐릭터"
          width="832"
          height="1040"
          fetchpriority="high"
        />
        <Character client:visible />
      </div>

      <div>
        <p class="text-sm font-medium tracking-wide text-teal-deep">{profile.role}</p>
        <h1 class="mt-2 text-[2rem] font-semibold text-ink sm:text-[2.5rem]">{profile.name}</h1>
        <p class="mt-3 text-lg text-ink">{profile.tagline}</p>
        <div class="prose mt-6 space-y-4">
          {profile.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <ul class="mt-8 flex flex-wrap gap-3">
          {
            profile.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-mint"
                  rel="me noopener"
                  target="_blank"
                >
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="blog" class="mx-auto max-w-5xl px-5 pb-24">
    <h2 class="mb-6 text-2xl font-semibold text-ink">Blog</h2>
    <PostList posts={posts} />
  </section>
</Base>

<style>
  .fallback {
    transition: opacity 0.4s ease;
  }

  [data-stage][data-ready] .fallback {
    opacity: 0;
  }
</style>

<script>
  // 지금 보고 있는 섹션의 내비 항목에 밑줄
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav, a]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a, id) => {
          if (id === entry.target.id) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('#about, #blog').forEach((s) => observer.observe(s));
</script>
